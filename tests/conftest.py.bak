import os
import requests
import pytest
from google.cloud import firestore


@pytest.fixture(scope="session")
def api_url():
    """Get API URL from environment variable or use localhost default."""
    return os.environ.get("API_URL", "http://localhost:8080")


@pytest.fixture(scope="session", autouse=True)
def warmup(api_url, firestore_client):
    """Warm up gRPC and HTTP connections before any tests run."""
    try:
        requests.get(f"{api_url}/health", timeout=10)
    except Exception:
        pass
    try:
        firestore_client.collection('benchmarks').document('phase_0').get()
    except Exception:
        pass


@pytest.fixture(scope="session")
def firestore_client():
    """Initialize Firestore client for testing."""
    return firestore.Client(project="crisisnet-2026")


@pytest.fixture(scope="session")
def project_id():
    """Return the GCP project ID."""
    return "crisisnet-2026"
